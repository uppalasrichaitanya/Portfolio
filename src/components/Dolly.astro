---
// The bridge from hero to content: a sticky stage the camera flies through.
const words = [
  { text: "Systems", cls: "" },
  { text: "robotics", cls: "italic text-signal" },
  { text: "from scratch", cls: "" },
];
---

<section id="dolly" class="dolly relative z-10" aria-label="Interlude">
  <div class="dolly-stage">
    {
      words.map((w) => (
        <span data-dolly-word class:list={["dolly-word display", w.cls]}>
          {w.text}
        </span>
      ))
    }

    <div id="dolly-caption" class="dolly-caption container-x">
      <p class="label"><span class="text-signal">Fig. 00</span> — the shape of a search</p>
      <p class="mt-3 max-w-[34rem] text-[clamp(1.2rem,2.2vw,1.6rem)] leading-snug text-text">
        Every point is a vector. Every edge, a decision. <span class="accent">One path finds the answer.</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Without motion (no JS or reduced motion) this is a simple typographic interlude. */
  .dolly-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25em;
    padding: 6rem 1.25rem;
    font-size: clamp(3.5rem, 12vw, 10rem);
    text-align: center;
  }
  .dolly-word {
    display: block;
    line-height: 0.95;
  }
  .dolly-caption {
    margin-top: 2rem;
    font-size: 1rem;
    text-align: left;
  }

  :global(html.motion) .dolly {
    height: 340vh;
  }
  :global(html.motion) .dolly-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: 0;
    overflow: hidden;
  }
  :global(html.motion) .dolly-word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    white-space: nowrap;
    will-change: transform, opacity, filter;
    text-shadow: 0 0 60px rgb(12 10 9 / 0.8);
  }
  :global(html.motion) .dolly-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3.5rem;
    margin: 0 auto;
    opacity: 0;
  }
</style>
