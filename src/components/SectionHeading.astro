---
interface Props {
  id: string;
  /** Roman chapter number, e.g. "II". */
  chapter: string;
  eyebrow: string;
  title: string;
  accent?: string;
  aside?: string;
}
const { id, chapter, eyebrow, title, accent, aside } = Astro.props;
---

<div class="grid gap-x-10 gap-y-6 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-8">
    <p class="label flex items-center gap-3" data-reveal>
      <span class="text-signal">Chapter {chapter}</span>
      <span class="h-px w-10 bg-signal/50" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h2 id={id} class="display mt-6 text-[clamp(3rem,8vw,7rem)]" data-split>
      {title}
      {accent && <em class="accent">{accent}</em>}
    </h2>
  </div>
  {aside && <p class="max-w-[24rem] text-[15.5px] leading-relaxed text-muted lg:col-span-4 lg:justify-self-end" data-reveal style="--d:200ms">{aside}</p>}
</div>
