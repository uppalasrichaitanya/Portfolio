---
import { contact } from "../content/projects";

const home = Astro.url.pathname === "/";
const base = home ? "" : "/";
const links = [
  { href: `${base}#about`, label: "About", wide: false },
  { href: `${base}#work`, label: "Work", wide: false },
  { href: `${base}#experience`, label: "Experience", wide: true },
];
---

<header id="site-nav" class="fixed inset-x-0 top-3 z-50 px-3 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] sm:top-4">
  <div
    id="site-nav-bar"
    class="relative mx-auto flex h-14 max-w-[76rem] items-center justify-between overflow-hidden rounded-full border border-transparent pl-2 pr-2 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500"
  >
    <a href="/" data-curtain="Index" data-curtain-kicker="Back to" class="group flex items-center gap-3 rounded-full pr-3" aria-label="Uppala Sri Chaitanya, home">
      <span
        class="display grid h-10 w-10 place-items-center rounded-full border border-line-strong bg-raised/80 text-[19px] italic !text-signal transition-colors group-hover:border-signal"
        aria-hidden="true">U</span
      >
      <span class="hidden font-mono text-[11.5px] uppercase tracking-[0.14em] text-strong md:inline">Uppala Sri Chaitanya</span>
    </a>
    <nav aria-label="Sections">
      <ul class="flex items-center gap-0.5 font-mono text-[11.5px] uppercase tracking-[0.12em]">
        {
          links.map((l) => (
            <li class:list={[l.wide && "hidden sm:block"]}>
              <a href={l.href} class="rounded-full px-2.5 py-2 text-muted transition-colors hover:text-strong sm:px-3.5">
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="ml-1">
          <a href={contact.resume} target="_blank" rel="noreferrer" class="btn btn-ghost !h-10 !px-3.5 !text-[11px]">Resume</a>
        </li>
        <li class="ml-1.5">
          <a href="#contact" class="btn btn-primary !h-10 !px-3.5 !text-[11px]">Contact</a>
        </li>
      </ul>
    </nav>
    <span id="scroll-progress" class="pointer-events-none absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-signal" aria-hidden="true"></span>
  </div>
</header>

<script>
  // Solid bar after the first scroll; hides while scrolling down, returns on the way up.
  const solid = ["bg-raised/75", "border-line", "backdrop-blur-xl", "shadow-[0_10px_40px_-12px_rgba(0,0,0,0.8)]"];
  let last = window.scrollY;
  let ticking = false;
  const update = () => {
    ticking = false;
    const nav = document.getElementById("site-nav");
    const bar = document.getElementById("site-nav-bar");
    if (!nav || !bar) return;
    const y = window.scrollY;
    solid.forEach((c) => bar.classList.toggle(c, y > 24));
    const hide = y > last + 2 && y > 480 && !nav.contains(document.activeElement);
    if (y < last - 2 || y < 480) nav.style.transform = "";
    else if (hide) nav.style.transform = "translateY(-150%)";
    last = y;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  document.addEventListener("astro:page-load", () => {
    last = window.scrollY;
    update();
  });
</script>
