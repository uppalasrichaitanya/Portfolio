---
import CopyEmail from "./CopyEmail";
import Reveal from "../lib/motion";
import { contact } from "../content/projects";
const year = new Date().getFullYear();
---

<footer id="contact" class="container-x scroll-mt-20 pb-12 pt-28 sm:pt-40" aria-labelledby="contact-title">
  <Reveal client:visible>
    <p class="label">Contact</p>
    <h2 id="contact-title" class="mt-4 max-w-[44rem] text-[clamp(1.9rem,4.5vw,3.25rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-strong">
      Working on something hard? I'd like to hear about it.
    </h2>
    <div class="mt-10">
      <CopyEmail client:idle email={contact.email} />
    </div>
  </Reveal>

  <div class="mt-24 flex flex-col-reverse gap-6 border-t border-line pt-8 text-[14px] sm:flex-row sm:items-center sm:justify-between">
    <p class="text-faint">© {year} Uppala Sri Chaitanya</p>
    <ul class="flex gap-8">
      <li><a href={contact.github} target="_blank" rel="noreferrer" class="trace-link text-muted">GitHub ↗</a></li>
      <li><a href={contact.linkedin} target="_blank" rel="noreferrer" class="trace-link text-muted">LinkedIn ↗</a></li>
      <li><a href={`mailto:${contact.email}`} class="trace-link text-muted">Email</a></li>
    </ul>
  </div>
</footer>
