---
import { experience, contact } from "../content/projects";
import Icon from "./Icon.astro";
import PidScope from "./PidScope";
---

<section id="top" class="relative flex min-h-[100svh] flex-col overflow-hidden">
  <div class="glow left-[-10rem] top-[-14rem] h-[36rem] w-[52rem] opacity-60" aria-hidden="true"></div>

  <div class="container-x relative pt-28 sm:pt-32">
    <p class="hero-enter label flex flex-wrap items-center gap-x-3 gap-y-1" style="animation-delay:40ms">
      <span class="text-signal">{experience.role}</span>
      <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
      {experience.org}
    </p>

    <h1
      class="hero-enter mt-6 text-[clamp(3.3rem,9.6vw,8.4rem)] font-extrabold leading-[0.86] tracking-[-0.055em] text-strong"
      style="animation-delay:120ms"
    >
      Uppala<br />Sri Chaitanya<span class="text-signal">.</span>
    </h1>

    <div class="mt-7 grid gap-7 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p
          class="hero-enter text-[clamp(1.5rem,3.2vw,2.4rem)] font-semibold leading-[1.1] tracking-[-0.03em] text-muted"
          style="animation-delay:220ms"
        >
          Built from scratch. <span class="serif whitespace-nowrap text-[1.12em] text-signal">Measured honestly.</span>
        </p>
        <p class="hero-enter mt-5 max-w-[36rem] text-[17px] leading-relaxed text-muted" style="animation-delay:300ms">
          Systems &amp; robotics engineer. A vector database in Rust, an orchestrator for coding agents, a static-analysis
          mapper, and the servo-tuning tool our lab now runs on.
        </p>
      </div>

      <div class="hero-enter flex flex-wrap items-center gap-2.5 sm:gap-3 lg:col-span-5 lg:justify-end" style="animation-delay:400ms">
        <a href="#work" class="btn btn-primary">See the work <span aria-hidden="true">↓</span></a>
        <a href={contact.resume} class="btn btn-ghost hidden sm:inline-flex" target="_blank" rel="noreferrer">Résumé <Icon name="arrow-up-right" size={14} /></a>
        <a href={contact.github} target="_blank" rel="noreferrer" class="icon-btn" aria-label="GitHub"><Icon name="github" /></a>
        <a href={contact.linkedin} target="_blank" rel="noreferrer" class="icon-btn" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      </div>
    </div>
  </div>

  <!-- The signal, live: a PID loop the visitor steers. -->
  <div class="hero-enter relative mt-10 flex min-h-[13rem] flex-1 sm:mt-12" style="animation-delay:520ms">
    <div class="container-x relative flex-1 pb-8 pt-1">
      <div class="absolute inset-x-4 bottom-8 top-1 sm:inset-x-8">
        <PidScope client:idle hint="Move your cursor (or tap): this is the loop ServoPilot tunes." />
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-line" aria-hidden="true"></div>
  </div>
</section>
