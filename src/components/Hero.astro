---
import { experience, contact } from "../content/projects";
import Icon from "./Icon.astro";

// Letters are split at build time so the entrance runs in CSS, even without JS.
let n = 0;
const letters = (s: string) => [...s].map((ch) => ({ ch, i: n++ }));
const line1 = letters("Uppala Sri");
const line2 = letters("Chaitanya");
---

<!-- The galaxy lives behind the whole home page. -->
<div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
  <canvas id="galaxy" class="absolute inset-0 h-full w-full"></canvas>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,transparent_0%,rgba(12,10,9,0.35)_55%,rgba(12,10,9,0.92)_100%)]"></div>
</div>

<section id="top" class="relative z-10 h-[100svh] min-h-[620px]">
  <div id="hero-content" class="container-x relative flex h-full flex-col pb-10 pt-28 sm:pb-12 sm:pt-32">
    <div class="hero-enter flex items-start justify-between gap-6" style="animation-delay:150ms">
      <p class="label flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inset-0 rounded-full bg-signal/60 motion-safe:animate-ping [animation-duration:2.4s]"></span>
          <span class="relative h-1.5 w-1.5 rounded-full bg-signal"></span>
        </span>
        <span class="text-text">{experience.role}</span>
        <span class="text-faint">/</span>
        {experience.org}
      </p>
      <p class="label hidden text-right sm:block">Portfolio<br /><span class="text-text">MMXXVI</span></p>
    </div>

    <div class="mt-auto">
      <h1 class="display text-[clamp(4.2rem,14.5vw,13.5rem)] leading-[0.82]" aria-label="Uppala Sri Chaitanya">
        <span class="block whitespace-nowrap" aria-hidden="true">
          {line1.map((l) => (l.ch === " " ? <span class="inline-block w-[0.22em]" /> : <span class="hero-letter" style={`--i:${l.i}`}>{l.ch}</span>))}
        </span>
        <span class="block whitespace-nowrap pl-[0.06em] italic text-signal" aria-hidden="true">
          {line2.map((l) => <span class="hero-letter" style={`--i:${l.i}`}>{l.ch}</span>)}
          <span class="hero-letter text-strong not-italic" style={`--i:${n}`}>.</span>
        </span>
      </h1>

      <div class="mt-8 grid gap-7 border-t border-line pt-7 sm:mt-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="hero-enter text-[clamp(1.35rem,2.4vw,1.85rem)] leading-[1.15] tracking-[-0.01em] text-text" style="animation-delay:1100ms">
            Built from scratch. <span class="accent">Measured honestly.</span>
          </p>
          <p class="hero-enter mt-3 max-w-[34rem] text-[15.5px] leading-relaxed text-muted" style="animation-delay:1200ms">
            Systems &amp; robotics engineer: a vector database in Rust, an orchestrator for coding agents, a
            static-analysis mapper, and the servo-tuning tool our lab now runs on.
          </p>
        </div>
        <div class="hero-enter flex flex-wrap items-center gap-2.5 sm:gap-3 lg:col-span-6 lg:justify-end" style="animation-delay:1300ms">
          <a href="#work" class="btn btn-primary" data-magnetic="0.3">See the work <span aria-hidden="true">↓</span></a>
          <a href={contact.resume} class="btn btn-ghost" data-magnetic="0.3" target="_blank" rel="noreferrer">Resume <Icon name="arrow-up-right" size={13} /></a>
          <a href={contact.github} target="_blank" rel="noreferrer" class="icon-btn !hidden sm:!inline-grid" data-magnetic="0.4" aria-label="GitHub"><Icon name="github" /></a>
          <a href={contact.linkedin} target="_blank" rel="noreferrer" class="icon-btn !hidden sm:!inline-grid" data-magnetic="0.4" aria-label="LinkedIn"><Icon name="linkedin" /></a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-enter pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 lg:flex" style="animation-delay:1700ms" aria-hidden="true">
    <span class="label text-[10px]">Scroll</span>
    <span class="scroll-cue relative h-12 w-px overflow-hidden bg-line-strong"></span>
  </div>
</section>

<script>
  import "../lib/home";
</script>
