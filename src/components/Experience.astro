---
import SectionHeading from "./SectionHeading.astro";
import { experience as x } from "../content/projects";
---

<section id="experience" class="relative z-10 scroll-mt-24 py-32 sm:py-44" aria-labelledby="exp-title">
  <div class="container-x">
    <SectionHeading
      id="exp-title"
      chapter="III"
      eyebrow="Experience"
      title="Where the work"
      accent="happens."
      aside="Research and engineering on real robot arms, with a tool built along the way when one didn't exist."
    />

    <div class="card mt-16 grid gap-8 overflow-hidden p-6 sm:p-10 lg:grid-cols-12 lg:items-center" data-reveal data-spotlight>
      <div class="flex items-center gap-5 lg:col-span-5">
        <span class="display grid h-16 w-16 shrink-0 place-items-center rounded-2xl border border-signal/40 bg-signal-dim text-[28px] italic !text-signal" aria-hidden="true">T</span>
        <div>
          <h3 class="display text-[clamp(1.9rem,3.4vw,2.8rem)]">{x.org}</h3>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] uppercase tracking-[0.1em] text-muted">
            {x.role}
            <span class="inline-flex items-center gap-2 rounded-full border border-signal/30 bg-signal-dim px-2.5 py-1 text-signal">
              <span class="h-1.5 w-1.5 rounded-full bg-signal"></span>{x.period}
            </span>
          </p>
        </div>
      </div>
      <p class="text-[17px] leading-relaxed text-muted lg:col-span-7">{x.summary}</p>
    </div>

    <ol id="timeline" class="timeline relative mt-20 sm:mt-28">
      <span class="tl-rail" aria-hidden="true"><span id="tl-fill" class="tl-fill"></span></span>
      {
        x.steps.map((s, i) => (
          <li class:list={["tl-item", i % 2 === 1 && "tl-right"]} data-now={s.now ? "" : undefined}>
            <span class="tl-node" aria-hidden="true">
              <span class="tl-node-dot" />
            </span>
            <div class="tl-card card p-6 sm:p-7" data-tl-card data-spotlight>
              <p class="label">
                <span class="text-signal">Stage {String(i + 1).padStart(2, "0")}</span>
                {s.now && <span class="ml-2 rounded-full bg-signal px-2 py-0.5 text-[10px] font-semibold text-[#1a0c03]">Now</span>}
              </p>
              <h4 class="display mt-3 text-[clamp(1.7rem,2.6vw,2.3rem)]">
                {s.href ? (
                  <a href={s.href} data-curtain="ServoPilot" class="transition-colors hover:text-signal">
                    {s.title} <span class="accent text-[0.7em]">↗</span>
                  </a>
                ) : (
                  s.title
                )}
              </h4>
              <p class="mt-3 text-[15.5px] leading-relaxed text-muted">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <ul class="mt-16 flex flex-wrap justify-center gap-2" aria-label="Areas" data-reveal>
      {x.tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: 1.5rem;
  }
  .tl-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1rem;
    width: 1px;
    background: var(--color-line-strong);
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-signal-light), var(--color-signal));
    box-shadow: 0 0 18px rgb(255 138 61 / 0.6);
    transform-origin: top;
  }
  :global(html.motion) .tl-fill {
    transform: scaleY(0);
  }
  .tl-item {
    position: relative;
    padding-left: 3rem;
  }
  .tl-node {
    position: absolute;
    left: 1rem;
    top: 2rem;
    width: 1.1rem;
    height: 1.1rem;
    translate: -50% 0;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-bg);
    display: grid;
    place-items: center;
    transition:
      border-color 400ms,
      box-shadow 400ms;
  }
  .tl-node-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-faint);
    transition: background-color 400ms;
  }
  .tl-item[data-lit] .tl-node,
  :global(html:not(.motion)) .tl-node {
    border-color: var(--color-signal);
    box-shadow: 0 0 0 6px rgb(255 138 61 / 0.12);
  }
  .tl-item[data-lit] .tl-node-dot,
  :global(html:not(.motion)) .tl-node-dot {
    background: var(--color-signal);
  }
  .tl-item[data-now] .tl-node {
    animation: pulse-node 2.4s ease-out infinite;
  }
  .tl-item[data-now] .tl-card {
    border-color: rgb(255 138 61 / 0.45);
    background:
      radial-gradient(120% 120% at 0% 0%, rgb(255 138 61 / 0.14), transparent 60%),
      var(--color-raised);
  }
  @keyframes pulse-node {
    0% { box-shadow: 0 0 0 0 rgb(255 138 61 / 0.5); }
    100% { box-shadow: 0 0 0 18px rgb(255 138 61 / 0); }
  }

  @media (min-width: 1024px) {
    .timeline {
      gap: 0;
    }
    .tl-rail,
    .tl-node {
      left: 50%;
    }
    .tl-item {
      width: 50%;
      padding-left: 0;
      padding-right: 3.5rem;
      margin-bottom: -2rem;
    }
    .tl-item .tl-node {
      left: 100%;
    }
    .tl-right {
      margin-left: 50%;
      padding-right: 0;
      padding-left: 3.5rem;
    }
    .tl-right .tl-node {
      left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-item[data-now] .tl-node {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, onPage, reduced } from "../lib/scroll";

  onPage(() => {
    const tl = document.getElementById("timeline");
    const fill = document.getElementById("tl-fill");
    if (!tl || !fill || reduced()) return;

    gsap.to(fill, { scaleY: 1, ease: "none", scrollTrigger: { trigger: tl, start: "top 65%", end: "bottom 65%", scrub: 0.6 } });

    gsap.utils.toArray<HTMLElement>(".tl-item", tl).forEach((item) => {
      const card = item.querySelector("[data-tl-card]");
      const right = item.classList.contains("tl-right");
      const wide = window.innerWidth >= 1024;
      if (card) {
        gsap.from(card, {
          x: wide ? (right ? 90 : -90) : 0,
          y: wide ? 0 : 50,
          rotateY: wide ? (right ? -12 : 12) : 0,
          opacity: 0,
          transformPerspective: 1200,
          duration: 1.3,
          ease: "expo.out",
          scrollTrigger: { trigger: item, start: "top 82%" },
        });
      }
      gsap.timeline({ scrollTrigger: { trigger: item, start: "top 65%", onEnter: () => item.setAttribute("data-lit", ""), onLeaveBack: () => item.removeAttribute("data-lit") } });
    });
  });
</script>
