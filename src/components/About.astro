---
import SectionHeading from "./SectionHeading.astro";
import { about, skills, stats } from "../content/projects";

const all = skills.flatMap((s) => s.items);
const rowA = all.slice(0, Math.ceil(all.length / 2));
const rowB = all.slice(Math.ceil(all.length / 2));
---

<section id="about" class="relative z-10 scroll-mt-24 pt-28 sm:pt-40" aria-labelledby="about-title">
  <div class="container-x">
    <SectionHeading id="about-title" chapter="I" eyebrow="About" title="I build things" accent="to understand them." />

    <div class="mt-16 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-[clamp(1.35rem,2.5vw,1.9rem)] leading-[1.35] tracking-[-0.01em] text-text" data-split>
          {about.intro[0]}
        </p>
        <p class="mt-8 max-w-[38rem] text-[17px] leading-relaxed text-muted" data-reveal style="--d:150ms">{about.intro[1]}</p>

        <dl class="mt-12 grid max-w-[38rem] gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3" data-reveal style="--d:250ms">
          {
            about.facts.slice(0, 3).map((f) => (
              <div class="bg-bg/90 p-4 backdrop-blur">
                <dt class="label">{f.label}</dt>
                <dd class="mt-2 text-[14.5px] font-medium leading-snug text-strong">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <dl class="grid grid-cols-2 gap-px self-start overflow-hidden rounded-3xl border border-line bg-line lg:col-span-5" data-reveal style="--d:120ms">
        {
          stats.map((st) => (
            <div class="relative flex flex-col-reverse justify-end bg-raised/85 p-5 backdrop-blur sm:p-7" data-spotlight>
              <dt class="mt-3 text-[13px] leading-snug text-muted">{st.label}</dt>
              <dd
                class="display tabular text-[clamp(2.6rem,5vw,4rem)] leading-none"
                data-count={st.value}
                data-decimals={st.decimals ?? 0}
                data-suffix={st.suffix ?? ""}
                data-pad={st.pad ?? 0}
              >
                {st.pad ? String(st.value).padStart(st.pad, "0") : st.value.toFixed(st.decimals ?? 0)}{st.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Toolbox: two rows drifting in opposite directions. -->
  <div class="mt-24 sm:mt-32" aria-labelledby="toolbox-title">
    <div class="container-x flex items-end justify-between gap-6">
      <p id="toolbox-title" class="label" data-reveal><span class="text-signal">Toolbox</span> — what I reach for</p>
      <p class="label hidden sm:block" data-reveal>{all.length} tools</p>
    </div>
    <div class="marquee mt-6 space-y-3 overflow-hidden" data-reveal>
      {
        [rowA, rowB].map((row, r) => (
          <div class="marquee-track" data-reverse={r === 1 ? "" : undefined} style={`--dur:${r === 0 ? 46 : 54}s`}>
            {[...row, ...row].map((t, i) => (
              <span
                class:list={[
                  "flex items-center gap-3 whitespace-nowrap rounded-full border px-5 py-3 text-[clamp(1rem,1.6vw,1.25rem)]",
                  (i + r) % 4 === 0 ? "display border-signal/40 bg-signal-dim italic !text-signal" : "border-line-strong bg-raised/70 text-text",
                ]}
                aria-hidden={i >= row.length ? "true" : undefined}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-signal/70" aria-hidden="true" />
                {t}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
