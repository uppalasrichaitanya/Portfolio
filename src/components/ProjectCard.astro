---
import type { Project } from "../content/projects";
import Figure from "./Figure.astro";

interface Props {
  p: Project;
  flip?: boolean;
}
const { p, flip } = Astro.props;
const area = p.kicker.split("·")[1]?.trim().toLowerCase() ?? "";
const href = `/work/${p.id}`;
---

<article id={p.id} aria-labelledby={`${p.id}-title`} class="project-card card group scroll-mt-24 overflow-hidden p-4 sm:p-8 lg:p-10">
  <span
    aria-hidden="true"
    class="serif pointer-events-none absolute -top-3 select-none text-[clamp(7rem,16vw,13rem)] leading-none text-white/[0.035] transition-colors duration-500 group-hover:text-signal/[0.07]"
    class:list={[flip ? "left-6" : "right-6"]}>{p.index}</span
  >
  <div class="relative grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div data-reveal class:list={["lg:col-span-5", flip ? "lg:order-2" : "lg:order-1"]}>
      <p class="label flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="rounded-full border border-signal/40 bg-signal-dim px-2 py-0.5 text-signal">{p.index}</span>
        {p.kicker}
      </p>
      <h3 id={`${p.id}-title`} class="mt-5 text-[clamp(2.4rem,5vw,3.6rem)] font-extrabold leading-[1] tracking-[-0.04em] text-strong">
        <a href={href} class="trace-link pb-1 after:absolute after:inset-0 after:z-[1] after:content-['']" transition:name={`${p.id}-title`}>{p.title}</a>
      </h3>
      <p class="mt-5 max-w-[34rem] text-[17px] leading-relaxed text-muted sm:text-[18px]">{p.oneLiner}</p>

      <dl class="mt-8 grid grid-cols-3 gap-2 sm:gap-3">
        {
          p.proof.map((pr) => (
            <div class="flex min-w-0 flex-col-reverse justify-end rounded-xl border border-line bg-sunk/60 p-3 sm:p-4">
              <dt class="mt-2 text-[12px] leading-snug text-faint">{pr.label}</dt>
              <dd class="tabular font-mono text-[clamp(1.05rem,2vw,1.45rem)] font-medium leading-none tracking-tight text-strong">{pr.value}</dd>
            </div>
          ))
        }
      </dl>

      <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
        {p.stack.map((t) => <li class="chip">{t}</li>)}
      </ul>

      <p class="mt-8 inline-flex items-center gap-3 text-[15px] font-semibold text-strong">
        <span class="read-pill grid h-10 w-10 place-items-center rounded-full border border-line-strong transition-[background-color,border-color,color] duration-300 group-hover:border-signal group-hover:bg-signal group-hover:text-[#04110f]" aria-hidden="true">→</span>
        Read the case study
      </p>
    </div>

    <div data-reveal style="--d:120ms" class:list={["order-first lg:col-span-7", flip ? "lg:order-1" : "lg:order-2"]}>
      <Figure media={p.media} n={`${p.index}.1`} priority={p.index === "01"} chrome={`${p.id} — ${area}`} morph={`${p.id}-media`} />
    </div>
  </div>
</article>
