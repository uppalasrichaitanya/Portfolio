---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import AlsoBuilt from "../components/AlsoBuilt.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Chapter from "../components/Chapter";
import ChapterIndex from "../components/ChapterIndex";
import { projects } from "../content/projects";
---

<Base
  title="Uppala Sri Chaitanya: systems & robotics engineer"
  description="Built from scratch, measured honestly. DUM-E, Cartograph, ServoPilot and Quiver, plus robotics research at Teleparadigm Networks."
>
  <Nav />
  <ChapterIndex client:idle entries={projects.map((p) => ({ id: p.id, index: p.index, title: p.title }))} />
  <main id="main">
    <Hero />

    <section id="work" class="container-x scroll-mt-24 pt-16 sm:pt-24" aria-labelledby="work-title">
      <SectionHeading
        id="work-title"
        index="01"
        eyebrow="Selected work"
        title="Four systems,"
        accent="built from zero."
        aside="Each one has its numbers on the card and a full case study behind it: problem, approach, evidence, and what was hard."
      />
      <div class="mt-14 flex flex-col gap-5 sm:gap-8">
        {projects.map((p, i) => <Chapter client:visible p={p} flip={i % 2 === 1} />)}
      </div>
    </section>

    <Experience />
    <AlsoBuilt />
  </main>
  <Contact />
</Base>

<script>
  // Chapters hydrate when visible, so bring a deep-linked case into view; it opens itself on hydration.
  const m = window.location.hash.match(/^#case-([\w-]+)$/);
  if (m) document.getElementById(m[1])?.scrollIntoView({ block: "start" });
</script>
