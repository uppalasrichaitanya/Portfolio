---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import AlsoBuilt from "../components/AlsoBuilt.astro";
import SectionHeading from "../components/SectionHeading.astro";
import About from "../components/About.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../content/projects";
---

<Base
  title="Uppala Sri Chaitanya: systems & robotics engineer"
  description="Built from scratch, measured honestly. DUM-E, Cartograph, ServoPilot and Quiver, plus robotics research at Teleparadigm Networks."
>
  <Nav />
  <main id="main">
    <Hero />
    <About />

    <section id="work" class="container-x scroll-mt-24 pt-28 sm:pt-36" aria-labelledby="work-title">
      <SectionHeading
        id="work-title"
        index="02"
        eyebrow="Selected work"
        title="Four systems,"
        accent="built from zero."
        aside="Each one has its numbers on the card and its own page behind it: problem, approach, evidence, and what was hard."
      />
      <div class="mt-14 flex flex-col gap-5 sm:gap-8">
        {projects.map((p, i) => <ProjectCard p={p} flip={i % 2 === 1} />)}
      </div>
    </section>

    <Experience />
    <AlsoBuilt />
  </main>
  <Contact />
</Base>

<script is:inline>
  // Case studies used to open inline at #case-<id>; they live on their own pages now.
  (function () {
    var m = window.location.hash.match(/^#case-([\w-]+)$/);
    if (m) window.location.replace("/work/" + m[1]);
  })();
</script>
