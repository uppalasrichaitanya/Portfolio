---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Dolly from "../components/Dolly.astro";
import About from "../components/About.astro";
import WorkTrack from "../components/WorkTrack.astro";
import Experience from "../components/Experience.astro";
import AlsoBuilt from "../components/AlsoBuilt.astro";
import Contact from "../components/Contact.astro";
---

<Base
  title="Uppala Sri Chaitanya: systems & robotics engineer"
  description="Built from scratch, measured honestly. DUM-E, Cartograph, ServoPilot and Quiver, plus robotics research at Teleparadigm Networks."
>
  <Nav />
  <main id="main">
    <Hero />
    <Dolly />
    <About />
    <WorkTrack />
    <Experience />
    <AlsoBuilt />
  </main>
  <Contact />
</Base>

<script is:inline>
  // Case studies used to open inline at #case-<id>; they live on their own pages now.
  (function () {
    var m = window.location.hash.match(/^#case-([\w-]+)$/);
    if (m) window.location.replace("/work/" + m[1]);
  })();
</script>
