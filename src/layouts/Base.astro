---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import { ClientRouter } from "astro:transitions";
import Cursor from "../components/Cursor.astro";
import Curtain from "../components/Curtain.astro";
import "../styles/global.css";
import { contact, experience } from "../content/projects";

interface Props {
  title: string;
  description: string;
  /** Share card, relative to the site root. Project cards come from `npm run og`. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}
const { title, description, image = "/og.jpg", type = "website", noindex = false } = Astro.props;
const ogImage = new URL(image, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Tells search engines who the site is about, so the name links to the profiles.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Uppala Sri Chaitanya",
  url: Astro.site?.href,
  jobTitle: experience.role,
  worksFor: { "@type": "Organization", name: experience.org },
  sameAs: [contact.github, contact.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0a09" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <ClientRouter fallback="swap" />
    <script is:inline data-astro-rerun>
      (function () {
        var r = document.documentElement;
        if ("IntersectionObserver" in window) r.classList.add("js");
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) r.classList.add("motion");
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-raised focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <slot />
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    <Cursor />
    <Curtain />
    <script>
      import "../lib/scroll";
    </script>
  </body>
</html>
